# Copy to .env and fill in. Never commit .env.

# ── Django ───────────────────────────────────────────────────
DEBUG=True
# Required when DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=Asia/Kolkata

# Encrypts stored Google OAuth tokens. If unset it is derived from SECRET_KEY,
# which means rotating SECRET_KEY forces every user to reconnect Google.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────
# Blank = SQLite for local development. Railway/Heroku inject this.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Scoring engine ───────────────────────────────────────────
# "ollama" runs locally and needs no API key — the development default.
# "gemini" is the hosted option (also: pip install -r requirements-gemini.txt).
LLM_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
# Reasoning model used for resume extraction, skill verification and the rubric.
OLLAMA_MODEL=qwen3:14b
# Embedding model used for retrieval. 1024-dimensional.
OLLAMA_EMBED_MODEL=bge-m3

# Only needed when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seconds; local models on CPU can be slow, so this is generous.
LLM_TIMEOUT=180

# ── Scoring behaviour ────────────────────────────────────────
# Redact name, contact details and gendered terms before the LLM judges a resume.
BLIND_SCREENING=True
# Set False to skip the LLM rubric pass — roughly 3x faster, measurably less accurate.
RUBRIC_ENABLED=True

# ── GitHub enrichment ────────────────────────────────────────
# Without a token GitHub allows 60 requests/hour, which is about two candidates.
# A classic token with no scopes (public data only) raises it to 5000.
GITHUB_TOKEN=

# ── Google Workspace ─────────────────────────────────────────
# Production: paste the whole client_secrets.json as one line.
# Development: leave blank and put client_secrets.json in the project root.
GOOGLE_CLIENT_SECRETS=

# ── Optional ─────────────────────────────────────────────────
LOG_LEVEL=INFO
# ADMIN_EMAIL=you@example.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
